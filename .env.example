# Copy to .env.local and fill in. Never commit .env.local.
# Firebase console -> Project settings (gear icon) -> General -> "Your apps" -> Web app -> SDK setup and configuration (Config).
VITE_FIREBASE_API_KEY=        # config.apiKey
VITE_FIREBASE_AUTH_DOMAIN=    # config.authDomain  (yourproject.firebaseapp.com)
VITE_FIREBASE_PROJECT_ID=     # config.projectId
VITE_FIREBASE_APP_ID=         # config.appId  (1:123...:web:abc...)
